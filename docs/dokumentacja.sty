% ramki
% instrukcja dla zespołu (znika po \pokazinstrukcjefalse)
% \begin{instrukcja}[wymagane|zalecane] ... \end{instrukcja}
\newcommand{\dk@etykieta}[1]{%
  \ifstrequal{#1}{wymagane}{\fbox{\scriptsize\bfseries WYMAGANE - OCENIANE}}{%
  \ifstrequal{#1}{zalecane}{\fbox{\scriptsize ZALECANE}}{\fbox{\scriptsize #1}}}}
% przejście na nową stronę, gdy zostało mniej niż #1 miejsca
\newcommand{\dk@miejsce}[1]{\par\begingroup
  \dimen@=#1\relax\dimen@ii=\pagegoal\advance\dimen@ii-\pagetotal
  \ifdim\dimen@>\dimen@ii\ifdim\dimen@ii>\z@\newpage\fi\fi\endgroup}
\NewEnviron{instrukcja}[1][]{%
  \ifpokazinstrukcje
    \dk@miejsce{4.5cm}%
    \def\FrameCommand{\fboxsep=7pt\fcolorbox{dkramka}{dkjasny}}%
    \MakeFramed{\advance\hsize-\width\FrameRestore}\small
    {\bfseries Instrukcja}\ifstrempty{#1}{}{\hfill\dk@etykieta{#1}}\par\smallskip
    \BODY
    \endMakeFramed
  \fi}

% ramka wyróżniająca (zostaje w wersji do oddania)
\newenvironment{ramka}[1]{%
  \def\FrameCommand{\fboxsep=7pt\fcolorbox{dkczarny}{white}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}\small
  {\bfseries #1}\par\smallskip}
 {\endMakeFramed}

% tabele
\newcommand{\naglowektabeli}{\toprule\rowcolor{dknaglowek}}
\newcommand{\nt}[1]{\small\bfseries #1}
\renewcommand{\arraystretch}{1.3}

% status w tabelach
\newcommand{\tak}{\ding{51}\,tak}
\newcommand{\czesciowo}{$\pm$\,częściowo}
\newcommand{\nie}{\ding{55}\,nie}

% rysunki
% \zrzut{plik w obrazy/}{podpis}{szerokość jako ułamek \linewidth}
% jeśli pliku jeszcze nie ma, rysuje się puste pole z nazwą pliku
\newcommand{\zrzut}[3]{%
  \begin{figure}[H]\centering
  \IfFileExists{obrazy/#1}{\fbox{\includegraphics[width=#3\linewidth]{obrazy/#1}}}{%
    \begin{tikzpicture}
      \node[draw=dkramka,line width=0.6pt,dashed,fill=dkjasny,
            minimum width=#3\linewidth,minimum height=0.42*#3\linewidth,align=center,
            font=\small\color{dkszary}]
           {miejsce na zrzut ekranu\\[2pt]\texttt{obrazy/\detokenize{#1}}};
    \end{tikzpicture}}
  \caption{#2}\label{rys:#1}
  \end{figure}}

% style do mapy ekranów (TikZ)
\tikzset{
  ekran/.style={draw=black,line width=0.7pt,fill=white,rounded corners=2pt,
    font=\small,align=center,minimum width=2.9cm,minimum height=1.1cm},
  ekranglowny/.style={ekran,line width=1.4pt,font=\small\bfseries},
  przejscie/.style={-{Stealth[length=2.4mm]},line width=0.6pt,color=black},
  powrot/.style={przejscie,dashed},
  opis/.style={font=\scriptsize\itshape,fill=white,inner sep=1.5pt},
}

