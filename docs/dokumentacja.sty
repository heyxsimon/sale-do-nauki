\newcommand{\dkpokaz}[1]{\csname dk@#1\endcsname}

% skład zespołu: \osoba{imię i nazwisko}{nr albumu}{rola w projekcie}
\newcommand{\dk@osoby}{}
\newcommand{\dk@autorzy}{}
\newcommand{\osoba}[3]{%
